#!/usr/bin/with-contenv bash
# shellcheck shell=bash

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Channels DVR - Initialization"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Set permissions on config directory
chown -R abc:abc /channels-dvr
chmod 755 /channels-dvr

# Set permissions on recordings directory (top level only)
chown abc:abc /shares/DVR
chmod 755 /shares/DVR

# Download Channels DVR if not present
if [[ ! -f /channels-dvr/channels-dvr ]]; then
    echo "Channels DVR binary not found, downloading..."
    s6-setuidgid abc /usr/local/bin/setup.sh
elif [[ "${UPDATE_ON_START}" == "true" ]]; then
    echo "Checking for Channels DVR updates..."
    s6-setuidgid abc /usr/local/bin/setup.sh || true
else
    echo "Channels DVR binary found, skipping update check"
fi

# Check for Intel GPU
if [[ -e /dev/dri ]]; then
    echo "Intel GPU detected, testing VA-API..."
    s6-setuidgid abc vainfo 2>&1 | head -5 || echo "  VA-API not available"
fi

echo "Initialization complete"
