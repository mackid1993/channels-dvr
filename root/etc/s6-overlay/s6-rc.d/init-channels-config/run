#!/usr/bin/with-contenv bash
# shellcheck shell=bash

set -e

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Channels DVR - Initialization"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Set permissions on config directory FIRST (before download)
echo "Setting permissions..."
chown -R abc:abc /channels-dvr
chmod 755 /channels-dvr

# Set permissions on recordings directory (top level only)
chown abc:abc /shares/DVR 2>/dev/null || true
chmod 755 /shares/DVR 2>/dev/null || true

# Download Channels DVR only if not present (first run)
# The app handles its own updates internally for pre-releases
# Official installer creates: /channels-dvr/channels-dvr/latest/channels-dvr
if [[ ! -f /channels-dvr/channels-dvr/latest/channels-dvr ]]; then
    echo "Channels DVR binary not found, downloading..."
    s6-setuidgid abc /usr/local/bin/setup.sh
else
    echo "Channels DVR binary found, skipping download"
fi

# Verify binary exists
if [[ ! -f /channels-dvr/channels-dvr/latest/channels-dvr ]]; then
    echo "FATAL: Channels DVR binary not found at /channels-dvr/channels-dvr/latest/channels-dvr"
    exit 1
fi

# Check for Intel GPU
if [[ -e /dev/dri ]]; then
    echo "Intel GPU detected at /dev/dri"
fi

echo "Initialization complete"
